# Copy to .env and fill in your values.
# Reclaimerr > Settings > Account > API Tokens > Create Token
# Needs scopes: candidates:read, protections:read, system:read (read-only tools)
# plus candidates:manage, tasks:read, tasks:run (for the write tools below).
RECLAIMERR_URL=http://192.168.1.50:8000
RECLAIMERR_API_TOKEN=replace-with-your-reclaimerr-api-token

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8941

# Shared secret required as `Authorization: Bearer <token>` on every request.
# Leave unset to run with no auth (anyone who can reach the port can call
# every tool). Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
