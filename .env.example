# Copy to .env and fill in your values.
RECLAIMERR_URL=http://192.168.1.50:8000

# --- General tools (candidates, protections, tasks, system status) ---------
# Reclaimerr > Settings > Account > API Tokens > Create Token
# Needs scopes: candidates:read, protections:read, system:read (read-only tools)
# plus candidates:manage, tasks:read, tasks:run (for the write tools below).
# Leave unset to disable the general tools (e.g. to run rules tools only).
RECLAIMERR_API_TOKEN=replace-with-your-reclaimerr-api-token

# --- Rules tools (list/preview/create/update/delete cleanup rules) ---------
# Rules have no API-token equivalent, so these log in as a Reclaimerr user.
# The account MUST be an ADMIN, ideally a dedicated one so its sessions are easy to
# spot and revoke. Set both or neither. These tools also REQUIRE MCP_AUTH_TOKEN
# below: without it they stay disabled (see the README's "Rules management").
RECLAIMERR_USERNAME=
# A `$` in the password is silently truncated by Docker Compose: prefer a password
# without one, or write `$$` / single-quote it (see README, "Passwords, tokens and $").
RECLAIMERR_PASSWORD=

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8941

# Shared secret required as `Authorization: Bearer <token>` on every request.
# Optional for the general tools (unset = anyone who can reach the port can call
# every tool). REQUIRED to enable the rules tools. Generate one with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=
